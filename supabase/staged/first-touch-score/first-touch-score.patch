+/** Read-only: recent id-anchored audit rows per prospect. null = unreadable (no score quoted). */
+async function loadAuditScores(supabase: any, ids: string[]): Promise<Map<string, AuditScoreRow[]> | null> {
+  const out = new Map<string, AuditScoreRow[]>();
+  if (!ids.length) return out;
+  const { data, error } = await supabase
+    .from("ai_recommendation_audits")
+    .select("id, prospect_id, source, status, readiness_score, completed_at, baseline")
+    .in("prospect_id", ids)
+    .in("source", [...TRUSTED_SCORE_SOURCES])
+    .eq("status", "completed")
