+    .order("completed_at", { ascending: false })
+    .limit(Math.min(ids.length * 5, 500));
+  if (error) return null;
+  for (const r of (data ?? []) as AuditScoreRow[]) {
+    const k = String(r.prospect_id);
+    out.set(k, [...(out.get(k) ?? []), r]);
+  }
+  return out;
+}
