{
  "manifest_version": 3,
  "name": "UNPRO Scout",
  "version": "1.0.0",
  "description": "Capture les entrepreneurs visibles dans vos groupes Facebook vers le pipeline d'acquisition UNPRO.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*.facebook.com/*"],
  "action": { "default_popup": "popup.html", "default_title": "UNPRO Scout" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.facebook.com/*"],
      "js": ["scoutParser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
